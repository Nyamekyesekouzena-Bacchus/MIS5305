# Copy this file to .env and fill in real values.

# PostgreSQL connection string.
# Default matches the bundled Docker database (docker-compose.yml, host port 5433).
DATABASE_URL="postgresql://mis:mis_password@localhost:5433/mis5305?schema=public"

# Secret used to sign JWT access/refresh tokens (generate a random value)
# e.g. openssl rand -base64 32
AUTH_SECRET="change-me"
